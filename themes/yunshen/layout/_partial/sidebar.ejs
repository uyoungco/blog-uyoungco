<aside class="sidebar" aria-label="博客侧栏">
  <section class="sidebar-section"><h2 class="panel-heading">寻踪 <small>搜索文章</small></h2><button class="sidebar-search search-trigger" type="button"><%- yun_icon('search') %><span>搜篇名、签引…</span><kbd>/</kbd></button></section>
  <section class="sidebar-section"><h2 class="panel-heading">门类 <small>分门别类</small></h2><ul class="category-list"><li><a href="<%- url_for('/' + config.archive_dir + '/') %>"><span>全部文章</span><em><%= site.posts.length %></em></a></li><% site.categories.sort('name').each(category => { %><li><a href="<%- url_for(category.path) %>"><span><%= category.name %></span><em><%= category.length %></em></a></li><% }); %></ul></section>
  <% if (theme.quotes.length) { %><section class="quote-panel sidebar-section" data-quotes="<%= JSON.stringify(theme.quotes) %>"><h2 class="panel-heading">一日一签</h2><span class="quote-decoration" aria-hidden="true">“</span><blockquote><p data-quote-text><%= theme.quotes[0].text %></p><cite data-quote-author>— <%= theme.quotes[0].author %></cite></blockquote><button class="quote-refresh" type="button">另取一签 <span aria-hidden="true">↻</span></button></section><% } %>
  <% if (site.tags.length) { %><section class="sidebar-section"><h2 class="panel-heading">签引 <small>字里行间</small></h2><div class="tag-cloud"><% site.tags.sort('length', -1).limit(12).each(tag => { %><a href="<%- url_for(tag.path) %>"><%= tag.name %><sup><%= tag.length %></sup></a><% }); %></div></section><% } %>
  <a class="author-card" href="<%- url_for('/about/') %>"><span class="author-monogram"><%= theme.author.initial %></span><strong><%= config.author %></strong><p><%= theme.author.bio %></p><span class="text-link small">拜访洞府 <span>→</span></span></a>
</aside>
