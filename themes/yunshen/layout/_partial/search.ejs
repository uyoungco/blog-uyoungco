<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-index="<%- url_for('/search.json') %>">
  <div class="search-dialog-head">
    <div class="search-dialog-title">
      <h2 id="search-title">搜索文章</h2>
      <span aria-hidden="true">循字寻踪</span>
    </div>
    <button class="icon-button search-close" type="button" aria-label="关闭搜索" aria-keyshortcuts="Escape">
      <kbd aria-hidden="true">Esc</kbd><%- yun_icon('close') %>
    </button>
  </div>
  <form class="search-form" role="search">
    <%# 整个输入区域都可点击聚焦，关闭提示移到对应按钮旁。 %>
    <label class="search-field" for="search-input">
      <span class="sr-only">搜索关键词</span>
      <%- yun_icon('search') %>
      <input type="search" id="search-input" placeholder="输入关键词" autocomplete="off">
    </label>
  </form>
  <p class="search-status" role="status" aria-live="polite">可搜索标题、正文、分类和标签</p>
  <ol class="search-results"></ol>
</dialog>
